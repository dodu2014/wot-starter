{
  // Use oxc (oxlint + oxfmt) as default formatter
  "prettier.enable": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,

  // Auto fix with oxlint
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // Enable file nesting
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "vite.config.*": "pages.config.*, manifest.config.*, uno.config.*, volar.config.*, *.env, .env.*, alova.config.*, unh.config.*, tsconfig.*",
    "index.html": "readme.md, license, favicon.ico, changelog.*",
    ".oxlintrc.json": "commitlint.config.*, .editorconfig, .git-cz.*, .npmrc, .nvmrc, .versionrc, renovate.json, .gitignore"
  },

  // Associate JSON files with comments as JSONC
  "files.associations": {
    "**/pages.json": "jsonc",
    "**/manifest.json": "jsonc"
  },

  // Disable emoji in commit messages
  "GitCommitPlugin.ShowEmoji": false,
  // Adjust the maximum length of submission information
  "GitCommitPlugin.MaxSubjectCharacters": 50
}
